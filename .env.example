# Shared environment template — copy to .env and fill secrets

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
VOICE_WORKER_WS_URL=wss://localhost:8001/media
INTERNAL_API_SECRET=dev-internal-secret-change-me

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_ADDRESS_SID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs (required for spoken audio — all TTS goes through ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional: ElevenLabs Conversational AI agent id (not used for tool orchestration today)
ELEVENLABS_AGENT_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Observability
SENTRY_DSN=
ENVIRONMENT=development

# Platform admin (comma-separated user UUIDs)
PLATFORM_ADMIN_USER_IDS=
